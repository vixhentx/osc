(_flow fab_demo "2022.1-dev2"
    (_comment "Generated by Fabric Compiler (version on 2022.1-dev2<build 92133>) at Tue Apr 12 11:49:48 2022")
    (_version "1.0.8")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string ""))
        (_option prj_impl_dir (_string ""))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG676)
                )
            )
        )
        (_command cmd_load_arch
        (_gci_state (_integer 0))
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../../rtl/ipmxe_loadsc_n_gen_v1_0.v"
                    (_format verilog)
                    (_timespec "2022-04-12T11:47:48")
                )
                (_file "../../rtl/ipmxe_adc_sync_v1_0.v"
                    (_format verilog)
                    (_timespec "2022-04-12T11:47:48")
                )
                (_file "../../u_pango_adc.v" + "u_pango_adc"
                    (_format verilog)
                    (_timespec "2022-04-12T11:47:48")
                )
            )
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "u_pango_adc.fdc"
                    (_format fdc)
                    (_timespec "2022-04-12T11:47:48")
                )
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
        (_gci_state (_integer 0))
            (_option ads (_switch ON))
            (_option selected_syn_tool_opt (_integer 2))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
        (_gci_state (_integer 0))
        )
        (_widget wgt_edit_placement_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_pnr
        (_command cmd_pnr
        (_gci_state (_integer 0))
        )
        (_command cmd_report_post_pnr_timing
        (_gci_state (_integer 0))
            (_attribute _auto_exe_lock (_switch OFF))
            (_option configuration (_switch ON))
        )
        (_widget wgt_arch_browser
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream
        (_gci_state (_integer 0))
        )
    )
)
