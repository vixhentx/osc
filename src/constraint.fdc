# 时钟约束 - 使用顶层模块中实际的时钟端口名称
create_clock -name {clk_27m} [get_ports {clk_27m}] -period {37.000} -waveform {0.000 18.500}

# 系统时钟和复位 - 使用顶层模块中的实际端口名称
define_attribute {p:clk_27m} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:clk_27m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_27m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_27m} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n} {PAP_IO_NONE} {TRUE}

# ADC输入信号 - 根据您的设计使用正确的端口名称
define_attribute {p:adc_input_signal} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:adc_input_signal} {PAP_IO_LOC} {Y22}
define_attribute {p:adc_input_signal} {PAP_IO_VCCIO} {3.3}
define_attribute {p:adc_input_signal} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:adc_input_signal} {PAP_IO_NONE} {TRUE}

# FFT输出信号 - 使用顶层模块中定义的输出端口
define_attribute {p:fft_magnitude[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:fft_magnitude[0]} {PAP_IO_LOC} {V14}
define_attribute {p:fft_magnitude[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fft_magnitude[0]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:fft_magnitude[0]} {PAP_IO_DRIVE} {8}
define_attribute {p:fft_magnitude[0]} {PAP_IO_NONE} {TRUE}
define_attribute {p:fft_magnitude[0]} {PAP_IO_SLEW} {SLOW}

define_attribute {p:fft_magnitude[1]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:fft_magnitude[1]} {PAP_IO_LOC} {U14}
define_attribute {p:fft_magnitude[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fft_magnitude[1]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:fft_magnitude[1]} {PAP_IO_DRIVE} {8}
define_attribute {p:fft_magnitude[1]} {PAP_IO_NONE} {TRUE}
define_attribute {p:fft_magnitude[1]} {PAP_IO_SLEW} {SLOW}

# 继续添加更多幅度输出位...
define_attribute {p:fft_magnitude[2]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:fft_magnitude[2]} {PAP_IO_LOC} {Y21}
define_attribute {p:fft_magnitude[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fft_magnitude[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:fft_magnitude[2]} {PAP_IO_DRIVE} {8}
define_attribute {p:fft_magnitude[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:fft_magnitude[2]} {PAP_IO_SLEW} {SLOW}

