<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:communicators="clr-namespace:Oscum.Service"
             xmlns:vm="clr-namespace:Oscum.ViewModels"
             xmlns:design="clr-namespace:Oscum.Design"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Oscum.Views.ComView"
             x:DataType="vm:ComViewModel">
    <Design.DataContext><design:ComViewDesignModel/></Design.DataContext>
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <TextBlock Text="请选择通信端口(COM):" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshComPortsCommand}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Coms}" SelectedItem="{Binding ComSelected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="communicators:ICom">
                    <Panel>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Left" Margin="5" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="{Binding Type}" HorizontalAlignment="Right" Margin="5" FontWeight="Light"/>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
