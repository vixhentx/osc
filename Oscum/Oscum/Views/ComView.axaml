<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:communicators="clr-namespace:Oscum.Service"
             xmlns:vm="clr-namespace:Oscum.ViewModels"
             xmlns:design="clr-namespace:Oscum.Design"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Oscum.Views.ComView"
             x:DataType="vm:ComViewModel">
    <Design.DataContext><design:ComViewDesignModel/></Design.DataContext>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="请选择通信端口(COM):"/>
            <Button Content="刷新"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Coms}" SelectedItem="{Binding ComSelected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="communicators:ICom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Type}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
